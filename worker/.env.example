# Copy to .env on the server and fill in. Never commit .env.

# Shared database (same one the Vercel web app uses). Leave empty to use a local SQLite file.
DATABASE_URL=

# AI summaries (OpenRouter). Put your key here and the worker starts using it.
OPENROUTER_API_KEY=

# Telegram MTProto account (https://my.telegram.org -> API development tools)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# WhatsApp Business Cloud API (only needed when channels.whatsapp.enabled is true)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Optional proxies, only if NSE/BSE block the server address
NSE_PROXY_URL=
BSE_PROXY_URL=

# Optional: point to a different config file
# NSE_ALERTS_CONFIG=/opt/nse_alerts/worker/config.yaml
