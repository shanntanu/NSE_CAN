# Postgres connection string (Neon/Vercel: include ?sslmode=require)
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
# Enables /admin and /api/admin/*; leave empty to disable
ADMIN_TOKEN=
NEXT_PUBLIC_DEFAULT_COUNTRY_CODE=+91
# Set to false to activate subscriptions without the Telegram code step
REQUIRE_VERIFICATION=true
# WhatsApp Cloud API webhook
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
